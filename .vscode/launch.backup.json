{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Debug Spring Boot App",
            "request": "launch",
            "mainClass": "com.SpringEduManager.web.WebApplication",
            "projectName": "web",
            "args": [],
            "vmArgs": [
                "-Xdebug",
                "-Xrunjdwp:transport=dt_socket,server=y,suspend=n,address=5005"
            ],
            "env": {
                "SPRING_PROFILES_ACTIVE": "dev"
            },
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart",
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "maven-compile"
        }
    ],
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "maven-compile",
                "type": "shell",
                "command": "mvn",
                "args": ["compile"],
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "silent",
                    "focus": false,
                    "panel": "shared"
                }
            }
        ]
    }
}
